#!/usr/bin/env bash
#
# Springfield pre-commit hook: run the full test suite before allowing a commit.
#
# Activate once per clone:
#   git config core.hooksPath .githooks
#
# Skip a single commit (use sparingly): git commit --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Strip parent-commit git env so child git invocations inside tests
# (e.g. `git worktree add` in temp dirs) resolve their own working tree
# instead of the outer commit's index.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
      GIT_NAMESPACE GIT_COMMON_DIR

if ! command -v go >/dev/null 2>&1; then
  echo "pre-commit: 'go' not on PATH; skipping tests" >&2
  exit 0
fi

echo "pre-commit: running 'go test ./...'"
if ! go test ./...; then
  echo "pre-commit: tests failed — commit aborted" >&2
  exit 1
fi
