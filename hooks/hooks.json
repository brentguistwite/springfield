{
  "description": "Springfield — block interactive writes to the .springfield/ control plane",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "springfield hook-guard" }
        ]
      }
    ]
  }
}
